{
  "name": "db-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:desktop": "concurrently -k -n web,electron -c blue,magenta \"vite\" \"wait-on tcp:5173 && node scripts/build-node.mjs electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm run build:web && node scripts/build-node.mjs all",
    "build:web": "tsc -b && vite build",
    "start": "cross-env NODE_ENV=production node dist-server/index.mjs",
    "start:desktop": "npm run build && electron .",
    "dist:desktop": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:up": "docker compose -f docker/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:reset": "docker compose -f docker/docker-compose.yml down -v && docker compose -f docker/docker-compose.yml up -d --wait",
    "db:psql": "docker exec -it dbtracker-pg psql -U dbtracker -d tienda"
  },
  "devDependencies": {
    "@dbml/core": "^10.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@monaco-editor/react": "^4.7.0",
    "@octokit/rest": "^22.0.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "bonjour-service": "^1.4.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "hono": "^4.13.13",
    "html-to-image": "^1.11.13",
    "lib0": "^0.2.119",
    "lucide-react": "^1.60.0",
    "monaco-editor": "^0.57.0",
    "mysql2": "^3.24.6",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "oxlint": "^1.88.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.8",
    "react-router": "^8.5.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1",
    "ws": "^8.22.0",
    "y-indexeddb": "^9.0.12",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "main": "dist-electron/main.mjs",
  "description": "Gestor visual de bases de datos con versiones por flujo (web y escritorio)"
}
